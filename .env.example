# Database Configuration
DATABASE_URL="postgresql://waykanan:waykanan_password@localhost:5432/waykanan_agro?schema=public"

# Authentication & Session Security (Stateless JWT signed with jose HS256, 30 days)
JWT_SECRET="waykanan_secret_jwt_token_key_at_least_32_characters_long_super_secure"

# WhatsApp Gateway Driver: "console" (Development, prints OTP to server console) or "fonnte" (Production)
WA_GATEWAY_DRIVER="console"
FONNTE_TOKEN="your_fonnte_api_token_here"

# Background Job & Cron Authentication
CRON_SECRET="waykanan_cron_secret_stock_confirmation_key_998877"

# Public Platform Configuration
NEXT_PUBLIC_APP_NAME="Way Kanan Agro-Commerce"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
PRICE_SOURCE_AGENCY="Dinas Ketahanan Pangan & Pertanian Kab. Way Kanan"
ADMIN_WHATSAPP_HELP="6281234567890"
